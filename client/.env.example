# Client-side environment variables (exposed to the browser — must be prefixed with VITE_).
# Copy to ".env" inside the /client folder.
#
# IMPORTANT: never put secrets here — everything in this file is bundled into
# the browser. The frontend talks only to the Express API; it needs no DB keys.

# Base URL of the Express API.
# Leave empty in dev (Vite proxies /api -> localhost:4000).
# In production set it to your deployed API origin, e.g. https://api.hamondial.com
VITE_API_BASE_URL=
