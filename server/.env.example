# Server environment variables — copy to ".env" inside the /server folder.

# Supabase (database)
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Twilio (SMS / WhatsApp notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Football-Data.org (live fixtures & results)
FOOTBALL_DATA_API_KEY=your-football-data-api-key

# PayPlus (payments — leave empty until the payment phase)
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=

# Admin dashboard password (set a strong value)
ADMIN_PASSWORD=

# Server config
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
